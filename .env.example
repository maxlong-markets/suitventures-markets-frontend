# WalletConnect Cloud project id (https://dashboard.reown.com). Injected wallets
# (MetaMask, Rabby, Coinbase extension) work without it; the WalletConnect QR
# option needs it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Data layer. "mock" is the seeded MockDataSource from the design handoff;
# "envio" selects the live EnvioDataSource and needs the two ENVIO_ variables
# at the bottom of this file.
NEXT_PUBLIC_DATA_SOURCE=mock

# The Suits NFT contract on Robinhood Chain. When set, isSuitHolder is a live
# balanceOf() read. While unset the mock flag below decides.
NEXT_PUBLIC_SUITS_NFT_ADDRESS=

# Only read while NEXT_PUBLIC_SUITS_NFT_ADDRESS is unset: "true" treats every
# connected wallet as a Suit holder (0% router fee state), "false" as a
# regular wallet (0.5%).
NEXT_PUBLIC_MOCK_SUIT_HOLDER=true

# Stubbed SVRouter outcome: "success" (default) or "failed" to exercise the
# failed-swap toast.
NEXT_PUBLIC_MOCK_TX_OUTCOME=success

# Optional RPC override (Alchemy in production). Defaults to the public RPC.
NEXT_PUBLIC_RPC_URL=

# Server-only. The indexer's GraphQL endpoint and its API key from Envio Cloud (Security tab), not the HyperSync token.
ENVIO_GRAPHQL_URL=
ENVIO_GRAPHQL_KEY=
