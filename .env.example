# WalletConnect Cloud project id (https://dashboard.reown.com). Injected wallets
# (MetaMask, Rabby, Coinbase extension) work without it; the WalletConnect QR
# option needs it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Data layer. "mock" is the seeded MockDataSource from the design handoff;
# "envio" selects the live EnvioDataSource and needs the two ENVIO_ variables
# at the bottom of this file.
NEXT_PUBLIC_DATA_SOURCE=mock

# SVRouter on Robinhood Chain, once it is deployed. Empty disables execution only: the
# quote route still answers and every number on the trade panel is real, but the button
# reads "Trading goes live when the router is deployed". scripts/fork/ writes a local
# router address into .env.fork for the anvil harness.
NEXT_PUBLIC_SVROUTER_ADDRESS=

# The instant launchpad's address on Robinhood Chain; set it only after the contract is deployed. Empty keeps /launch on "not live yet" and the reader off its logs.
NEXT_PUBLIC_LAUNCHPAD_ADDRESS=

# The Suits NFT contract on Robinhood Chain. Drives two independent things, on purpose
# (token-gate design doc §3): the token gate below, which turns on the moment this is set,
# and isSuitHolder's live balanceOf() read for the 0.5% → 0% fee badge. Setting this address
# does NOT by itself grant the fee perk — that ALSO needs NEXT_PUBLIC_SVROUTER_ADDRESS set
# above AND SVRouter.suitsNft() pointed at this same address, a separate on-chain call Kobe
# makes; until then every holder still pays 0.5% even though the gate already lets them in.
# While unset the mock flag below decides isSuitHolder, and the app is ungated.
#
# LEFT BLANK ON PURPOSE. The live value is:
#   0x05c2174aa494bbdf72aeeab0ca3c10216d33b297
# Only the router fee perk reads it now (the "Suit holder, 0% fee" badge, D34): the holders-only
# access gate was removed on 9 Oct 2026 and the whole app is public. Set it on Vercel per
# environment for the badge; a fresh checkout without it simply shows the 0.5% fee everyone pays.
NEXT_PUBLIC_SUITS_NFT_ADDRESS=

# Only read while NEXT_PUBLIC_SUITS_NFT_ADDRESS is unset — which is the default above, so this
# flag is live in a fresh checkout and dead in a configured one. Anything but "true" means "not
# a holder" (0.5% router fee), which is what an unconfigured build must show: the fee every user
# will actually pay. Set it to "true" to demo the 0% holder state.
NEXT_PUBLIC_MOCK_SUIT_HOLDER=

# Optional BACKUP RPC for the browser (a paid endpoint). The browser always tries the chain's public
# node first and only falls back to this one when the public node refuses a visitor's burst; a
# 127.0.0.1 URL (the local fork harness) is used alone instead. Ships in the bundle: restrict its
# key by domain.
NEXT_PUBLIC_RPC_URL=

# Server-only. The HyperSync token the chain reader authenticates with, from Envio's HyperSync dashboard.
# Required; ENVIO_API_TOKEN is read as a fallback.
HYPERSYNC_API_TOKEN=

# Server-only, optional. The HyperSync endpoint the chain reader queries. Defaults to https://4663.hypersync.xyz.
HYPERSYNC_URL=

# Server-only, optional. Primary RPC for the reader's chain reads (token metadata, Chainlink prices,
# holder-count balance reads, the health check's head). Defaults to the chain's public node, and is
# always paced at that node's limit of 40 calls per second.
CHAIN_RPC_URL=
# Server-only, optional. Backup RPC (a paid endpoint, never in the bundle): a call the primary refuses
# with 429, times out or fails with a 5xx is retried here once before it counts as failed.
CHAIN_RPC_FALLBACK_URL=

# Server-only, no longer used: the hosted indexer they pointed at was cancelled on 21 September 2026 and the
# chain reader above replaced it.
ENVIO_GRAPHQL_URL=
ENVIO_GRAPHQL_KEY=

# Server-only, optional. RPC used by the token-logo reads; defaults to the public RPC.
ROBINHOOD_RPC_URL=

# Market store (server-only)
DATABASE_URL=            # Supabase pooler, transaction mode, port 6543
DATABASE_URL_DIRECT=     # Supabase session pooler, port 5432; laptop scripts only
CRON_SECRET=             # 32 random bytes; Vercel sends it as a Bearer token to the cron routes
MARKET_DATA_BACKEND=     # no longer read: Envio was decommissioned 21 Sep 2026, and there is nothing left to roll back to
SYNC_INTERVAL_SEC=       # seconds between sync cycles inside one invocation; default 30

# Social layer (server-only)
SESSION_SECRET=          # 32 random bytes, `openssl rand -hex 32`; unset → sign-in and user data off, reads unaffected
SESSION_DOMAIN=          # Production only — a preview deployment's host differs and every sign-in there would fail. The host the site is served on, e.g. suitventures-markets-frontend.vercel.app; unset = trust the Host header, fine on Vercel, weak behind a Host-forwarding proxy

TRADERS_BOARD=           # "off" keeps the parked /api/traders behind its "needs the market store" answer while the store cannot rank in time (19 Sep 2026: ~40 s a query until the swaps table is reordered by time or the board reads a rollup). Corrected 30 Sep 2026: the Traders tab and the /traders page are removed, and the route stays parked.

# Instant launchpad image storage, server-only
# Filebase S3 access key for the launch image bucket; required for uploads and the nightly clean-up.
FILEBASE_ACCESS_KEY=
# Filebase S3 secret key for that bucket; required, never in the bundle.
FILEBASE_SECRET_KEY=
# The Filebase IPFS bucket launch images and metadata are pinned to; required.
FILEBASE_BUCKET=
# Optional: a dedicated Filebase gateway's https origin, tried first for ipfs:// logos; https origin only, defaults to https://ipfs.filebase.io.
FILEBASE_GATEWAY_URL=
